{
    "name": "now-here/laravel-gettext",
    "description": "Adds localization support to laravel applications in an easy way using Poedit and GNU gettext.",
    "homepage": "https://github.com/now-here/laravel-gettext",
    "keywords": [
        "gettext",
        "localization",
        "poedit",
        "laravel-gettext",
        "laravel",
        "translation"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolás Daniel Palumbo",
            "email": "n@xinax.net"
        },
        {
            "name": "Antoine Aflalo",
            "email": "dev+laravel_gettext@zerospam.ca"
        }
    ],
    "support": {
        "issues": "https://github.com/now-here/laravel-gettext/issues"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "symfony/translation": "^6.4 || ^7.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "laravel/laravel": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Xinax\\LaravelGettext\\": "src/Xinax/LaravelGettext/"
        },
        "files": [
            "src/Xinax/LaravelGettext/Support/helpers.php"
        ]
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Xinax\\LaravelGettext\\LaravelGettextServiceProvider"
            ]
        }
    }
}
